{
  "version": 8,
  "name": "resume-china-map",
  "metadata": {
    "about": "主题 v1.0 地图画法：garden 水墨（淡墨细线+朱砂星） / code 像素（荧光绿方块） / ai 玻璃（赛博蓝发光+琥珀暗角）。v0.1 备份见 map-style-v0.1.json",
    "themes": [
      "garden",
      "code",
      "ai",
      "future"
    ],
    "projection": {
      "type": "simple-cylindrical",
      "bounds": [
        73,
        18,
        135,
        54
      ]
    },
    "canvasMapping": {
      "role:bg": "径向渐变起点色 + gradientEnd",
      "role:outline": "国界轮廓线（dash=手绘/像素叠层）",
      "role:provinces": "省级界线",
      "role:rivers": "河流中心线",
      "role:lakes": "湖泊填充",
      "role:labels": "国名/周边地理文字",
      "role:marker": "城市标记（shape: star/square/dot/glow）"
    },
    "version": "1.0"
  },
  "sources": {
    "china-geo": {
      "type": "geojson",
      "data": "assets/data/china-geo-data.js",
      "layers": [
        "outer",
        "holes"
      ]
    },
    "province-lines": {
      "type": "geojson",
      "data": "assets/data/china-geo-data.js",
      "layers": [
        "provinces"
      ]
    },
    "rivers": {
